{
  "name": "utools-funqr",
  "version": "1.0.0",
  "description": "码上生花 FunQR：离线二维码识别、文本转二维码与二维码美化工具",
  "license": "MIT",
  "homepage": "https://farfarfun.github.io/packages/utools-funqr/",
  "repository": {
    "type": "git",
    "url": "https://github.com/farfarfun-utools/utools-funqr.git"
  },
  "bugs": {
    "url": "https://github.com/farfarfun-utools/utools-funqr/issues"
  },
  "keywords": [
    "utools",
    "utools-plugin",
    "qr-code",
    "qrcode-generator",
    "qr-code-scanner",
    "offline",
    "vue3",
    "typescript",
    "farfarfun"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "screenshots": "pnpm build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.12",
    "@types/qrcode": "^1.5.6"
  }
}
